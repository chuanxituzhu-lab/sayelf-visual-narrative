{
  "$id": "hidden-window.output-contract.v1",
  "type": "object",
  "required": [
    "contract",
    "version",
    "output",
    "language",
    "scene",
    "seed",
    "variation",
    "visual_grammar",
    "outputs",
    "continuity",
    "dsap",
    "errors"
  ],
  "properties": {
    "contract": { "const": "hidden-nature-window.output" },
    "version": { "type": "string" },
    "output": { "enum": ["image", "storyboard", "both"] },
    "language": { "enum": ["zh", "en", "bilingual"] },
    "source": { "enum": ["preset", "composed"] },
    "scene": { "type": "object" },
    "seed": { "type": ["number", "string"] },
    "visual_grammar": {
      "const": ["enter", "enclose", "guide", "reveal"]
    },
    "continuity": {
      "type": "object",
      "required": ["continuity_id", "shot_order", "image_keyframe", "final_hold"],
      "properties": {
        "continuity_id": { "type": "string" },
        "shot_order": { "const": ["ENTER", "ENCLOSE", "GUIDE", "REVEAL", "HOLD"] },
        "image_keyframe": { "const": "REVEAL" },
        "final_hold": { "const": "HOLD" }
      }
    },
    "dsap": {
      "type": "object",
      "required": ["protocol", "version", "run_id", "goal", "decision", "state", "action", "proof", "ledger", "handoff"],
      "properties": {
        "protocol": { "const": "sayelf-nature-window.dsap" },
        "version": { "type": "string" },
        "run_id": { "type": "string" },
        "goal": { "type": "string" },
        "decision": {
          "type": "object",
          "required": ["selected_outputs", "output", "language", "acceptance_rule"]
        },
        "state": {
          "type": "object",
          "required": ["status", "current_from", "checkpoint", "resumable_scope", "next_check"],
          "properties": {
            "status": { "enum": ["READY", "RUNNING", "NEEDS_REVIEW", "BLOCKED", "FAILED", "COMPLETED"] },
            "current_from": { "const": "ledger" }
          }
        },
        "action": { "type": "object" },
        "proof": {
          "type": "object",
          "required": ["status", "contract_version", "continuity_id", "compiled_outputs", "failed_outputs", "evidence"]
        },
        "ledger": { "type": "array", "minItems": 4 },
        "handoff": {
          "type": "object",
          "required": ["status", "result_version", "result_types", "consumer", "resume_scope"]
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["type", "format", "prompt", "prompt_zh", "prompt_en"]
        },
        "storyboard": {
          "type": "object",
          "required": ["type", "format", "shot_count", "duration_seconds", "stages", "shots"]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "errors": { "type": "array" }
  }
}
