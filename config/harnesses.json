    { "id": "custom-api", "name": "Custom HTTP API", "transport": "api", "enabled": false, "description": "Example server-side HTTP API adapter. Keep the key in SAYELF_CUSTOM_API_KEY, never in this file.", "url": "http://127.0.0.1:9000/assist", "required_env": ["SAYELF_CUSTOM_API_KEY"], "header_env": { "Authorization": "SAYELF_CUSTOM_API_KEY" }, "capabilities": [{ "id": "assist", "name": "协作" }, { "id": "review", "name": "审阅" }, { "id": "refine", "name": "改写" }] }
