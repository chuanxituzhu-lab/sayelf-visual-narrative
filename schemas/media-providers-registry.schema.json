{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media/1.0/providers-registry",
  "title": "Sayelf Media Providers Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "providers"],
  "properties": {
    "contract_version": { "const": "media/1.0" },
    "provider_directories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "enabled", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "manifest": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
