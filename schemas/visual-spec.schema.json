{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sayelf.dev/schemas/visual-spec.schema.json",
  "title": "VisualSpec v1",
  "type": "object",
  "required": ["mode", "story", "style", "scene", "composition", "camera"],
  "properties": {
    "mode": {"enum": ["single_image", "story_sequence", "storyboard"]},
    "story": {
      "type": "object",
      "required": ["intent"],
      "properties": {
        "intent": {"type": "string", "minLength": 1},
        "theme": {"type": "string"},
        "emotional_arc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "required": ["visual_philosophy"],
      "properties": {
        "visual_philosophy": {"type": "string", "minLength": 1},
        "medium": {"type": "string"},
        "shape_language": {"type": "string"},
        "material_language": {"type": "string"},
        "color_strategy": {"type": "string"},
        "texture_density": {"type": "string"},
        "contrast_strategy": {"type": "string"},
        "forbidden_patterns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "character": {"type": "object", "additionalProperties": true},
    "world": {"type": "object", "additionalProperties": true},
    "scene": {
      "type": "object",
      "required": ["intent", "decisive_moment"],
      "properties": {
        "intent": {"type": "string"},
        "beat": {"type": "string"},
        "decisive_moment": {"type": "string", "minLength": 1},
        "emotional_state": {"type": "string"},
        "visual_state": {"type": "string"}
      },
      "additionalProperties": true
    },
    "performance": {"type": "object", "additionalProperties": true},
    "evidence": {"type": "object", "additionalProperties": true},
    "staging": {"type": "object", "additionalProperties": true},
    "composition": {
      "type": "object",
      "required": ["primary", "information_route"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "string"},
        "information_route": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "negative_space": {"type": "string"},
        "complexity_budget": {"type": "string"}
      },
      "additionalProperties": true
    },
    "camera": {
      "type": "object",
      "required": ["shot_size"],
      "properties": {
        "narrative_distance": {"type": "string"},
        "shot_size": {"type": "string", "minLength": 1},
        "height": {"type": "string"},
        "angle": {"type": "string"},
        "lens_tendency": {"type": "string"},
        "depth": {"type": "string"}
      },
      "additionalProperties": true
    },
    "light_color": {"type": "object", "additionalProperties": true},
    "constraints": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
