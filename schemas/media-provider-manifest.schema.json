{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media/1.0/provider-manifest",
  "title": "Sayelf Media Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "name", "version", "kind", "capabilities", "plugin", "source"],
  "properties": {
    "contract_version": { "const": "media/1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "media-provider" },
    "transport": { "enum": ["local", "api", "mcp"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["text_to_image", "image_to_video", "text_to_video"] }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_env": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "entrypoint"],
      "properties": { "module": { "type": "string", "minLength": 1 }, "entrypoint": { "const": "createProvider" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 } }
    }
  }
}
